SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
JWT_SECRET=
TMDB_READ_ACCESS_TOKEN=
OPENAI_API_KEY=
OMDB_API_KEY=
APP_ENV=development
APP_PORT=8080
RATE_LIMIT_RPM=60
ALLOWED_ORIGINS=http://localhost:3000
RANKER_URL=http://localhost:8000

# Assistant model: any OpenAI-compatible chat API. Local Ollama shown; for a
# hosted provider set its base URL, model, and key. Unset runs search-only.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_REASONING_EFFORT=none

# Daily caps (UTC). Past the global caps the assistant answers from search alone.
# Production assistant model, read by deploy/cloudrun-backend.sh.
DEPLOY_LLM_BASE_URL=
DEPLOY_LLM_MODEL=
DEPLOY_LLM_API_KEY=
DEPLOY_LLM_REASONING_EFFORT=

ASSISTANT_USER_DAILY_RUNS=25
ASSISTANT_GUEST_DAILY_RUNS=8
ASSISTANT_DAILY_RUNS=1000
ASSISTANT_DAILY_TOKENS=2000000
EMBED_DAILY_LIMIT=5000
